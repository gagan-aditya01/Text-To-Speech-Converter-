# ElevenLabs API key (optional — required only for premium voices)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Default TTS engine: "gtts" or "elevenlabs"
TTS_ENGINE=gtts

# Default language code (BCP-47 format)
DEFAULT_LANGUAGE=en

# Audio output directory
OUTPUT_DIR=outputs

# App log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
